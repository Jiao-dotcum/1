{
  "name": "pokerpandey",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based multiplayer poker casino with proximity voice chat",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @pokerpandey/server dev\" \"pnpm --filter @pokerpandey/client dev\"",
    "build": "pnpm --filter @pokerpandey/shared build && pnpm -r build",
    "typecheck": "pnpm --filter @pokerpandey/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @pokerpandey/server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  }
}
