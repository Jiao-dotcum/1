# PokerPandey — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env` with real secrets.

# ── LiveKit (spatial voice) ───────────────────────────────────────────────────
# Get free-tier keys at https://cloud.livekit.io (see SETUP.md).
# The server uses these to mint short-lived client join tokens.

# Your LiveKit project URL, e.g. wss://your-project.livekit.cloud
# (or ws://localhost:7880 for a local --dev server)
LIVEKIT_URL=

# API key, looks like APIxxxxxxxx
LIVEKIT_API_KEY=

# API secret (shown once when you create the key — copy it immediately)
LIVEKIT_API_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Colyseus server listens on (default 2567)
PORT=2567

# ── Client ────────────────────────────────────────────────────────────────────
# Where the browser client connects to the server. Set in client/.env if you
# need to override the default ws://localhost:2567
# VITE_SERVER_URL=ws://localhost:2567
