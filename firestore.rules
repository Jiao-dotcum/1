rules_version = '2';

// ============================================================
// Pixel Pal Firestore rules
// ------------------------------------------------------------
// NOTE: You chose "one global list everyone shares", so these rules let
// ANY visitor read and write the shared task list. That is exactly the
// behaviour you asked for, but be aware: anyone who knows the site URL
// can see and edit the tasks. If you later want it private, switch to a
// shared secret / Firebase Auth and gate the rules on it.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // The shared task list.
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Device push tokens. Clients add their own token; the Cloud Function
    // (admin) reads them to send pushes. Public create/read keeps setup
    // simple; tokens are not sensitive on their own.
    match /pushTokens/{token} {
      allow read, write: if true;
    }
  }
}
